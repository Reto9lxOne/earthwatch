{
  "title": "Earthwatch — Overview",
  "uid": "earthwatch-overview",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "tags": ["earthwatch"],
  "panels": [

    {
      "id": 1, "type": "stat", "title": "Earthquakes (24h)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT COUNT(*) AS value FROM earthquakes WHERE time > now() - interval '24h'",
        "format": "table", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    },

    {
      "id": 2, "type": "stat", "title": "Strongest (24h)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT ROUND(MAX(magnitude)::numeric, 1) AS value FROM earthquakes WHERE time > now() - interval '24h'",
        "format": "table", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 5 },
          { "color": "orange", "value": 6 },
          { "color": "red", "value": 7 }
        ]}
      }}
    },

    {
      "id": 3, "type": "stat", "title": "Active Events",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT COUNT(DISTINCT event_id) AS value FROM natural_events WHERE status = 'open' AND time > now() - interval '7 days'",
        "format": "table", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] } } }
    },

    {
      "id": 4, "type": "stat", "title": "Solar Events (48h)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT COUNT(*) AS value FROM solar_events WHERE time > now() - interval '48h'",
        "format": "table", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] } } }
    },

    {
      "id": 5, "type": "stat", "title": "Collector (10m)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT COUNT(*) AS value FROM collector_runs WHERE time > now() - interval '10 minutes' AND success = true",
        "format": "table", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "green", "value": 1 }
        ]}
      }}
    },

    {
      "id": 6, "type": "stat", "title": "Max Radiation (7d) µSv/h",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT ROUND(MAX(value_usv)::numeric, 4) AS value FROM radiation_measurements WHERE time > now() - interval '7 days'",
        "format": "table", "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 4, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.1 },
          { "color": "orange", "value": 0.3 },
          { "color": "red", "value": 1.0 }
        ]}
      }}
    },

    {
      "id": 7, "type": "timeseries", "title": "Earthquakes per 2h (last 7d)",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT time_bucket('2 hours', time) AS time, COUNT(*) AS \"Count\", ROUND(MAX(magnitude)::numeric,1) AS \"Max Magnitude\" FROM earthquakes WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
        "format": "time_series", "refId": "A"
      }],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },

    {
      "id": 8, "type": "timeseries", "title": "Solar Events per 6h (last 7d)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT time_bucket('6 hours', time) AS time, event_type AS metric, COUNT(*) AS value FROM solar_events WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1",
        "format": "time_series", "refId": "A"
      }],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },

    {
      "id": 9, "type": "table", "title": "Collector Runs (latest 25)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "rawSql": "SELECT time AS \"Time\", source AS \"Source\", records AS \"Records\", ROUND(duration_ms/1000.0,1) AS \"Sec\", CASE WHEN success THEN '✅' ELSE '❌' END AS \"Status\", COALESCE(error, '') AS \"Error\" FROM collector_runs ORDER BY time DESC LIMIT 25",
        "format": "table", "refId": "A"
      }],
      "options": { "sortBy": [{ "displayName": "Time", "desc": true }] },
      "fieldConfig": { "defaults": { "custom": { "displayMode": "auto" } } }
    }

  ]
}
