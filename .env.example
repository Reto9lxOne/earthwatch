# ─────────────────────────────────────────────────────
# EARTHWATCH — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git!
# ─────────────────────────────────────────────────────

# Database
DB_PASSWORD=change_me_strong_password
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=earthwatch
DB_USER=earthwatch

# Grafana
GRAFANA_PASSWORD=change_me_grafana_password

# Telegram Alerts (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: NASA API Key (DEMO_KEY works but has lower rate limits)
# Get free key at: https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Optional: AIS ship stream token
AISSTREAM_TOKEN=your_aisstream_token_here

# Web service
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000
EXTERNAL_CACHE_TTL_MS=60000
